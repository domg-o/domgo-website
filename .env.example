# Google Analytics 4 web-stream Measurement ID for domgo.co.uk
# Analytics only loads after the visitor opts in. A GA measurement ID is public,
# but keep environment-specific configuration out of the repository.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional editorial statistics helper (`npm run stats:update`). These values
# are server-side secrets and are never required by the website build.
TIKTOK_ACCESS_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=
YT_API_KEY=
YT_CHANNEL_ID=
